# O gate de commit do backend: lint, tipos, documento OpenAPI e a suíte.
#
# O `cd` é obrigatório: o git executa o hook com o cwd na raiz do repositório,
# e este é um monorepo - `pnpm lint` na raiz não existe. `$0` chega como
# `backend/.husky/pre-commit`, então dois níveis acima é `backend/`.
cd "$(dirname "$0")/.." || exit 1

# Só roda se o commit tocar o backend: um commit que muda apenas o frontend não
# tem por que esperar a suíte funcional, que sobe Postgres e MinIO.
if ! git diff --cached --name-only | grep -q '^backend/'; then
  exit 0
fi

# `--check` e não a geração: gerar dentro do hook deixaria o `openapi.json` novo
# fora do commit que o produziu, e o próximo commit levaria a mudança de outra
# pessoa. Aqui ele recusa, e quem mexeu no controller roda
# `node ace openapi:generate` e refaz o `git add`.
pnpm lint && pnpm typecheck && node ace openapi:generate --check && pnpm test
